{
  "name": "luxqmk-studio",
  "productName": "LuxQMK Studio",
  "version": "1.4.0",
  "description": "LuxQMK Studio - Professional Keyboard Configuration, Audio Visualizer & RGB Suite",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "test": "node test_suite.js",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:installer": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.luxqmk.studio",
    "productName": "LuxQMK Studio",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "assets/**/*",
      "bin/**/*"
    ],
    "asarUnpack": [
      "bin/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LuxQMK Studio"
    }
  },
  "keywords": [
    "luxqmk",
    "gmmk3",
    "qmk",
    "via",
    "keyboard",
    "rgb",
    "audio-visualizer",
    "webhid"
  ],
  "author": "DoreK",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "archiver": "^5.3.2",
    "electron-builder-squirrel-windows": "^25.1.8",
    "fs-extra": "^10.1.0"
  }
}
